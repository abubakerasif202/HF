NEXT_PUBLIC_SITE_EMAIL=admin@hfremovalsadelaide.com.au
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=b3427589-09df-4f1c-abae-5b3fc3266ba5
NEXT_PUBLIC_GA_ID=G-C1L7YK52TM

# --- Booking system -----------------------------------------------------
# The site builds and runs fine with all of the below unset — the "Book
# Your Move" flow simply stays disabled and customers use "Get a Quote"
# instead. See README.md "Booking system setup" for the full walkthrough.

NEXT_PUBLIC_SITE_URL=https://www.hfremovalsadelaide.com.au

# Supabase (database of record + staff auth). The ONLY requirement for
# the booking system to turn on — no advance payment is taken, so Stripe
# is not needed to accept bookings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — OPTIONAL / LEGACY. Not required for booking (no advance
# payment). Only needed if you keep the dormant /api/stripe/webhook
# running for historical Stripe-era bookings; leave blank otherwise.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email). Optional — bookings still confirm without
# it, but customers/admin won't get email notifications until it's set.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_ADMIN_EMAIL=
# Quote bridge reuses the above Resend key, sender and admin recipient.
# All three are required for quote notifications; no customer quote email is sent.

# Per-IP rate limiting for /api/booking/{availability,hold,confirm}.
# Server-only HMAC key (never NEXT_PUBLIC_). Required for the limiter to
# run; if unset it is skipped (fails open) and bookings still work.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# Google Calendar mirror of confirmed bookings (optional, never
# authoritative). All four are needed; otherwise sync shows "Disabled".
# GOOGLE_CALENDAR_ID may be "primary" or a dedicated calendar's ID.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Vercel Cron auth for /api/cron/expire-holds. Required for the
# scheduled hold-expiry sweep; without it the inline expiry-on-hold-attempt
# logic still runs, it just isn't swept proactively.
CRON_SECRET=


